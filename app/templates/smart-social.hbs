<div class="phone phone--smart" style={{container-style this.model.configs}}>
  <LoadingBar/>
  <div class="camera">
    <img src="/images/camera.png" alt="camera">
  </div>

  <div class="app">
    <div class="app-bar">

      <BackBtn @id="back" @onClick= {{action "goBack"}} @src={{this.model.commons.back}} />

      <img id="fabIcon" src={{this.model.configs.social}} alt="">
      <span id="iconName">{{this.model.configs.iconName}}</span>
    </div>
    <div>
      <h2>Hi <span id="socialId">{{this.userDetails.socialAccount}}</span></h2>
    </div>
  </div>
</div>